# MindOS Paradise'ın Debian'a eklediği / değiştirdiği sistem dosyaları (imaj köküne göre yollar).
# scripts/export-from-build.sh bu listeyi imajdan overlay/ klasörüne kopyalar,
# scripts/apply-overlay.sh overlay/'ı bir Debian köküne uygular. Joker (*) kullanılabilir.

# --- Paket yönetimi ve güncellemeler
etc/apt/sources.list
etc/apt/apt.conf.d/20auto-upgrades
etc/apt/apt.conf.d/50unattended-upgrades
etc/systemd/system/apt-daily.service.d/10-not-on-live.conf
etc/systemd/system/apt-daily-upgrade.service.d/10-not-on-live.conf
etc/systemd/system/unattended-upgrades.service.d/10-not-on-live.conf
etc/dpkg/dpkg.cfg.d/01-mindos-slim
etc/mindpkg/mindpkg.conf
etc/mindos-release
usr/share/bash-completion/completions/mindpkg
usr/lib/systemd/system/mindos-system-update.service
usr/lib/systemd/system/system-update.target.wants/mindos-system-update.service

# --- Kimlik ve markalama
usr/lib/os-release
etc/issue
etc/issue.net
etc/default/grub
etc/skel/.face
