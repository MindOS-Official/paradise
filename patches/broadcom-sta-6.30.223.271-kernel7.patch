diff -ruN a/src/shared/linux_osl.c b/src/shared/linux_osl.c
--- a/src/shared/linux_osl.c	2025-03-20 14:48:52.000000000 +0300
+++ b/src/shared/linux_osl.c	2026-10-15 11:54:31.247063509 +0300
@@ -860,7 +860,17 @@
 char*
 osl_strncpy(char *d, const char *s, uint n)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+	/* strncpy kernel 7'de kaldırıldı; aynı davranış: en fazla n bayt, kalan kısım sıfırla doldurulur */
+	uint i = 0;
+	for (; i < n && s[i]; i++)
+		d[i] = s[i];
+	for (; i < n; i++)
+		d[i] = '\0';
+	return d;
+#else
 	return (strncpy(d, s, n));
+#endif
 }
 
 char*
