+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+/* MindOS: kernel 7 cfg80211 imzaları (radio_idx eklendi, anahtar ve istasyon işlemleri
+ * net_device yerine wireless_dev alıyor); asıl işlevler değiştirilmeden çağrılır */
+static int wl_k7_set_wiphy_params(struct wiphy *wiphy, int radio_idx, u32 changed)
+{
+	return wl_cfg80211_set_wiphy_params(wiphy, changed);
+}
+static int wl_k7_get_station(struct wiphy *wiphy, struct wireless_dev *wdev, const u8 *mac,
+	struct station_info *sinfo)
+{
+	return wl_cfg80211_get_station(wiphy, wdev->netdev, mac, sinfo);
+}
+static int wl_k7_set_tx_power(struct wiphy *wiphy, struct wireless_dev *wdev, int radio_idx,
+	enum nl80211_tx_power_setting type, int mbm)
+{
+	return wl_cfg80211_set_tx_power(wiphy, wdev, type, mbm);
+}
+static int wl_k7_get_tx_power(struct wiphy *wiphy, struct wireless_dev *wdev, int radio_idx,
+	unsigned int link_id, int *dbm)
+{
+	return wl_cfg80211_get_tx_power(wiphy, wdev, link_id, dbm);
+}
+static int wl_k7_add_key(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id, u8 key_idx,
+	bool pairwise, const u8 *mac_addr, struct key_params *params)
+{
+	return wl_cfg80211_add_key(wiphy, wdev->netdev, link_id, key_idx, pairwise, mac_addr, params);
+}
+static int wl_k7_del_key(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id, u8 key_idx,
+	bool pairwise, const u8 *mac_addr)
+{
+	return wl_cfg80211_del_key(wiphy, wdev->netdev, link_id, key_idx, pairwise, mac_addr);
+}
+static int wl_k7_get_key(struct wiphy *wiphy, struct wireless_dev *wdev, int link_id, u8 key_idx,
+	bool pairwise, const u8 *mac_addr, void *cookie, void (*callback)(void *cookie, struct key_params *))
+{
+	return wl_cfg80211_get_key(wiphy, wdev->netdev, link_id, key_idx, pairwise, mac_addr, cookie, callback);
+}
+#define wl_cfg80211_set_wiphy_params wl_k7_set_wiphy_params
+#define wl_cfg80211_get_station wl_k7_get_station
+#define wl_cfg80211_set_tx_power wl_k7_set_tx_power
+#define wl_cfg80211_get_tx_power wl_k7_get_tx_power
+#define wl_cfg80211_add_key wl_k7_add_key
+#define wl_cfg80211_del_key wl_k7_del_key
+#define wl_cfg80211_get_key wl_k7_get_key
+#endif
