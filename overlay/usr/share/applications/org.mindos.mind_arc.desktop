[Desktop Entry]
Name=Mind-Arc Kontrol Merkezi
Name[en]=Mind-Arc Control Center
Comment=MindOS sistem yönetimi, paket merkezi ve bakım araçları
Comment[en]=MindOS system management, package center and maintenance
Exec=mind-arc %F
Icon=mind-arc
Terminal=false
Type=Application
Categories=System;Settings;Utility;
Keywords=mindos;mindpkg;paket;package;sistem;system;ayar;settings;
StartupNotify=true
StartupWMClass=org.mindos.mind_arc
MimeType=application/vnd.debian.binary-package;application/x-mindos-package;
