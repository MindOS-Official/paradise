def search_repos(query, limit=40):
    """Depolarda arar: önce tam ad, sonra adla başlayan, adında geçen, açıklamada geçen"""
    query = query.lower().strip()
    print(f"{COLOR_ACCENT}==>{COLOR_RESET} Aranıyor: '{COLOR_BOLD}{query}{COLOR_RESET}' ...\n")
    installed = {p.stem for p in Path(INSTALLED_DIR).glob("*.json")}
    ranked = []
    for name, pkg in repo_index().items():
        n, desc = name.lower(), str(pkg.get("description", "")).lower()
        if n == query:
            score = 0
        elif n.startswith(query):
            score = 1
        elif query in n:
            score = 2
        elif query in desc:
            score = 3
        else:
            continue
        ranked.append((score, len(name), name, pkg))
    found = False
    if ranked:
        found = True
        ranked.sort()
        print(f"{COLOR_BOLD}MindOS deposu{COLOR_RESET}")
        for _, _, name, pkg in ranked[:limit]:
            mark = f" [{COLOR_ACCENT}kurulu{COLOR_RESET}]" if name in installed else ""
            print(f"  {COLOR_GREEN}{name}{COLOR_RESET} {pkg.get('version')}{mark}")
            print(f"    {pkg.get('description', '')}")
        if len(ranked) > limit:
            print(f"\n  ... ve {len(ranked) - limit} paket daha. Aramayı daraltın.")
    vend = [(pkg, spec) for pkg, spec in VENDOR_APPS.items()
            if query in pkg or any(query in a for a in spec["aliases"])]
    if vend:
        found = True
        print(f"\n{COLOR_BOLD}Üreticinin resmi deposu{COLOR_RESET}")
        for pkg, spec in vend:
            print(f"  {COLOR_GREEN}{spec['aliases'][0]}{COLOR_RESET}  ({pkg})")
    if shutil.which("apt-cache"):
        out = subprocess.run(["apt-cache", "search", "--names-only", query], capture_output=True, text=True).stdout
        deb = [l.split(" - ", 1) for l in out.splitlines() if " - " in l]
        deb.sort(key=lambda x: (x[0] != query, not x[0].startswith(query), len(x[0])))
        if deb:
            found = True
            print(f"\n{COLOR_BOLD}Debian{COLOR_RESET}")
            for n, d in deb[:15]:
                print(f"  {COLOR_GREEN}{n}{COLOR_RESET}  {d}")
            if len(deb) > 15:
                print(f"  ... ve {len(deb) - 15} paket daha.")
    fps = flatpak_search(query)
    alias = flatpak_alias(query)
    if alias and alias not in [a for a, _, _ in fps]:
        fps.insert(0, (alias, alias.rsplit(".", 1)[-1], ""))
    if fps:
        found = True
        print(f"\n{COLOR_BOLD}Flathub{COLOR_RESET}")
        for app_id, title, desc in fps:
            print(f"  {COLOR_GREEN}{app_id}{COLOR_RESET}  {title}{(' - ' + desc) if desc else ''}")
    if found:
        print(f"\nKurmak için: {COLOR_BOLD}sudo mindpkg install <ad veya kimlik>{COLOR_RESET}")
    else:
        print(f"'{query}' ile eşleşen bir paket bulunamadı.")


def build_package(source_dir, output_file=None):
    """Bir dizinden resmi .mind paketi inşa eder"""
    src_path = Path(source_dir).resolve()
    meta_file = src_path / "metadata.json"
    files_dir = src_path / "rootfs"

    if not meta_file.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} {meta_file} bulunamadı!")
        sys.exit(1)

    with open(meta_file, "r", encoding="utf-8") as f:
        meta = json.load(f)

    pkg_name = meta.get("name", "unnamed")
    require_pkg_name(pkg_name)
    pkg_ver = meta.get("version", "1.0.0")
    pkg_rel = meta.get("release", "1")
    pkg_arch = meta.get("architecture", get_system_arch())

    if not output_file:
        output_file = f"{pkg_name}-{pkg_ver}-{pkg_rel}-{pkg_arch}.mind"

    print(f"{COLOR_GREEN}==>{COLOR_RESET} Paket derleniyor: {COLOR_BOLD}{output_file}{COLOR_RESET} ...")

    with tempfile.TemporaryDirectory() as tmpdir:
        tmp_path = Path(tmpdir)
        shutil.copy2(meta_file, tmp_path / "metadata.json")

        for hook in ["pre_install.sh", "post_install.sh", "pre_remove.sh", "post_remove.sh"]:
            h_file = src_path / hook
            if h_file.exists():
                shutil.copy2(h_file, tmp_path / hook)

        files_archive = tmp_path / "files.tar.zst"
        if files_dir.exists():
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "--owner=0", "--group=0", "--numeric-owner",
                            "-C", str(files_dir), "."], check=True)
        else:
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "--files-from", "/dev/null"], check=True)

        subprocess.run(["tar", "--zstd", "-cf", str(Path(output_file).resolve()), "--owner=0", "--group=0",
                        "--numeric-owner", "-C", str(tmp_path), "."], check=True)

    print(f"{COLOR_GREEN}✓ BAŞARILI:{COLOR_RESET} {output_file} hazırlandı! ({os.path.getsize(output_file):,} bayt)")


