def pending_mind_packages():
    """Depoda daha yenisi olan kurulu .mind paketleri: [(ad, eski_kayıt, yeni_kayıt)]"""
    pending = []
    for rec in sorted(Path(INSTALLED_DIR).glob("*.json")):
        try:
            with open(rec, "r", encoding="utf-8") as f:
                old = json.load(f)
        except Exception:
            continue
        name = old.get("name", rec.stem)
        new = find_in_index(name) if valid_pkg_name(name) else None
        if new and is_newer(full_version(new), full_version(old)):
            pending.append((name, old, new))
    return pending


def install_mind_upgrade(name, old, path):
    """İndirilmiş .mind yükseltmesini kurar, eski sürümden kalan dosyaları temizler"""
    install_mind_file(path)
    with open(Path(INSTALLED_DIR) / f"{name}.json", "r", encoding="utf-8") as f:
        now = set(json.load(f).get("installed_files", []))
    delete_tracked_files([p for p in old.get("installed_files", []) if p not in now])


def upgrade_mind_packages():
    """Kurulu .mind paketlerinden depoda yenisi olanları yükseltir"""
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS (.mind) paketleri denetleniyor...")
    pending = pending_mind_packages()
    if not pending:
        print(f"  {COLOR_GREEN}✓{COLOR_RESET} Tüm .mind paketleri güncel.")
        return 0
    for name, old, new in pending:
        print(f"  • {COLOR_BOLD}{name}{COLOR_RESET} {full_version(old)} → {full_version(new)}")
    for name, old, new in pending:
        try:
            install_mind_upgrade(name, old, fetch_verified(name, new))
        except SystemExit:
            print(f"  {COLOR_YELLOW}⚠ {name} yükseltilemedi, diğerleriyle devam ediliyor.{COLOR_RESET}")
    return len(pending)


def apt_pending():
    """apt ile yükseltilecek paketlerin adları (benzetim; yetki gerektirmez)"""
    if not shutil.which("apt-get"):
        return []
    r = subprocess.run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "--with-new-pkgs", "upgrade"],
                       capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"})
    return [line.split()[1] for line in r.stdout.splitlines() if line.startswith("Inst ")]


