def get_system_arch():
    """Sistem mimarisini döner: 'x86_64' veya 'aarch64'"""
    m = os.uname().machine.lower()
    if m in ("aarch64", "arm64", "armv8l", "armv8b"):
        return "aarch64"
    return "x86_64"


def get_debian_arch():
    """Debian paket mimarisini döner: 'amd64' veya 'arm64'"""
    return "arm64" if get_system_arch() == "aarch64" else "amd64"


def get_default_repo_url(arch=None):
    """Mimariye göre varsayılan resmi MindOS depo adresi"""
    if arch is None:
        arch = get_system_arch()
    if arch in ("aarch64", "arm64"):
        return "https://raw.githubusercontent.com/MindOS-Official/packages-arm64/main"
    return "https://raw.githubusercontent.com/MindOS-Official/packages/main"


def get_default_config():
    arch = get_system_arch()
    return {
        "architecture": arch,
        "cache_dir": CACHE_DIR,
        "repositories": [
            {
                "name": "official",
                "url": get_default_repo_url(arch),
                "enabled": True
            }
        ]
    }


