# Broadcom Wi-Fi (mindpkg install broadcom)
#   Kernel'in kendi sürücüsü (brcmfmac, brcmsmac, b43, bcma) kartı çalıştırıyorsa hiçbir şey yapılmaz.
#   Çalıştırmıyorsa Broadcom'un "wl" sürücüsü kurulur: Debian'ın broadcom-sta-dkms paketi kernel 7.x
#   için yamalanıp MindOS sistem bileşeni olarak yayınlanır (Debian'ınki 7.x'te derlenmiyor).
# ------------------------------------------------------------------------------
BROADCOM_GRUB = "/etc/default/grub.d/mindos-broadcom-wl.cfg"


def broadcom_wifi():
    """[(aygıt satırı, kullanılan sürücü|None)] Broadcom ağ denetleyicileri"""
    out = subprocess.run(["lspci", "-nnk", "-d", "14e4:"], capture_output=True, text=True).stdout
    cards, cur = [], None
    for line in out.splitlines():
        if not line.startswith(("\t", " ")):
            cur = [line, None] if re.search(r"\[028[0-9]\]", line) else None
            if cur:
                cards.append(cur)
        elif cur and "Kernel driver in use:" in line:
            cur[1] = line.split(":", 1)[1].strip()
    return [tuple(c) for c in cards]


BROADCOM_LOG = "/var/log/mindos-broadcom.log"


def ensure_broadcom_module():
    """wl.ko çalışan kernel için derlenmiş ve kurulmuş olmalı. Yoksa DKMS derlemesini baştan yapar;
    olmazsa nedenini ekrana ve /var/log/mindos-broadcom.log dosyasına yazar. True: modül hazır."""
    rel = os.environ.get("MINDPKG_KERNEL") or os.uname().release

    def have():
        return subprocess.run(["modinfo", "-k", rel, "wl"], capture_output=True).returncode == 0

    if have():
        return True
    print(f"{COLOR_YELLOW}wl modülü {rel} için henüz yok; derleniyor...{COLOR_RESET}")
    log = [f"kernel: {rel}\n"]
    env = {**os.environ, **APT_ENV}
    def run(cmd, **kw):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, **kw)
            return r.returncode, r.stdout + r.stderr
        except OSError as e:  # komut yok (ör. dkms henüz kurulu değil)
            return 127, f"{cmd[0]}: {e}\n"

    # Paket "açılmış ama yapılandırılmamış" yarım durumdaysa (bağımlılık kurulamadığında) apt başka paket
    # kurmayı reddeder; önce yarım kalan kurulum tamamlanır, sonra derleme araçları kesin kurulur
    for cmd in (["dpkg", "--configure", "-a"], ["apt-get", "install", "-f", "-y", *APT_OPTS],
                ["apt-get", "install", "-y", *APT_OPTS, "dkms", "build-essential"]):
        rc, out = run(cmd, env=env)
        log.append(f"== {' '.join(cmd[:3])} (çıkış {rc})\n{out[-1500:]}")
    srcs = sorted(Path("/usr/src").glob("broadcom-sta-*"))
    ver = srcs[-1].name.split("broadcom-sta-", 1)[1] if srcs else None
    if not ver:
        log.append("HATA: /usr/src/broadcom-sta-* yok (paket kurulmamış)\n")
    elif not Path(f"/lib/modules/{rel}/build").exists():
        log.append(f"HATA: /lib/modules/{rel}/build yok (kernel başlıkları kurulu değil)\n")
    else:
        run(["dkms", "add", f"broadcom-sta/{ver}"])  # kayıtlıysa zararsız
        rc, out = run(["dkms", "install", f"broadcom-sta/{ver}", "-k", rel, "--force"])
        log.append(f"== dkms install (çıkış {rc})\n{out[-3000:]}")
        mk = Path(f"/var/lib/dkms/broadcom-sta/{ver}/build/make.log")
        if rc != 0 and mk.exists():
            tail = "".join(mk.read_text(errors="replace").splitlines(keepends=True)[-40:])
            log.append("== make.log (son satırlar)\n" + tail)
        run(["depmod", "-a", rel])
    ok = have()
    try:
        Path(BROADCOM_LOG).write_text("".join(log), encoding="utf-8")
    except OSError:
        pass
    if not ok:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Broadcom sürücüsü derlenemedi. Ayrıntılar: {BROADCOM_LOG}")
        shown = [l for l in "".join(log).splitlines() if re.search(r"error|HATA|fatal|Error", l)][:6]
        for l in shown:
            print(f"  {l[:150]}")
    return ok


def install_broadcom():
    check_root()
    if not (shutil.which("apt-get") and is_mindos_paradise()):
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Broadcom kurulumu yalnızca MindOS Paradise'ta desteklenir.")
        sys.exit(1)
    if is_live_session():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Canlı oturumda sürücü kurulamaz; önce MindOS'u diske kurun.")
        sys.exit(1)
    if kernel_flavor() == "debian":
        print(f"{COLOR_YELLOW}Bu bilgisayar Debian kernel'ini kullanıyor; Debian'ın broadcom-sta-dkms paketi kuruluyor.{COLOR_RESET}")
        ensure_debian_nonfree()
        subprocess.run(["apt-get", "update", "-qq"], check=False)
        deb_arch = get_debian_arch()
        sys.exit(subprocess.run(["apt-get", "install", "-y", *APT_OPTS, f"linux-headers-{deb_arch}",
                                 "broadcom-sta-dkms"], env={**os.environ, **APT_ENV}).returncode)
    cards = broadcom_wifi()
    if not cards:
        print(f"{COLOR_YELLOW}Bu bilgisayarda Broadcom Wi-Fi kartı bulunamadı.{COLOR_RESET}")
        return
    for line, drv in cards:
        print(f"  • {line.split(': ', 1)[-1]}  (sürücü: {drv or 'yok'})")
    if all(drv and drv != "wl" for _, drv in cards):
        print(f"{COLOR_GREEN}✓ Kartınız kernel'in kendi sürücüsüyle ({', '.join(d for _, d in cards)}) çalışıyor; "
              f"ek sürücü gerekmiyor.{COLOR_RESET}")
        return
    install_system_component("linux-headers")
    install_system_component("broadcom-sta-dkms")
    if not ensure_broadcom_module():
        sys.exit(1)
    # Broadcom'un hazır derlenmiş parçası Intel IBT'ye (dolaylı atlama koruması, 11. nesil ve sonrası)
    # hazır değil; bu işlemcilerde IBT yalnızca uyarı moduna alınır, yoksa sürücü çöker
    try:
        ibt_cpu = " ibt" in next(l for l in open("/proc/cpuinfo") if l.startswith("flags"))
    except (OSError, StopIteration):
        ibt_cpu = False
    if ibt_cpu and not os.path.exists(BROADCOM_GRUB):
        Path(BROADCOM_GRUB).parent.mkdir(parents=True, exist_ok=True)
        Path(BROADCOM_GRUB).write_text(
            '# MindOS: Broadcom wl sürücüsü Intel IBT ile çalışmaz; IBT uyarı modunda (mindpkg install broadcom)\n'
            'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT ibt=warn"\n', encoding="utf-8")
        subprocess.run(["update-grub"], check=False)
    code = queue_dkms_key_enrollment()
    if not code and not ibt_cpu:
        # açık kaynak Broadcom sürücüleri kartı tutuyorsa wl bağlanamaz; önce boşaltılır
        for mod in ("b43", "b43legacy", "brcmsmac", "brcmfmac", "bcma", "ssb"):
            subprocess.run(["modprobe", "-r", mod], capture_output=True)
        r = subprocess.run(["modprobe", "wl"], capture_output=True, text=True)
        if r.returncode == 0:
            import time
            time.sleep(3)
            ifaces = [n for n in os.listdir("/sys/class/net") if os.path.isdir(f"/sys/class/net/{n}/wireless")]
            if ifaces:
                print(f"\n{COLOR_GREEN}✓ Broadcom Wi-Fi sürücüsü (wl) çalışıyor: {', '.join(ifaces)}. "
                      f"Ağlar birkaç saniye içinde görünür.{COLOR_RESET}")
                return
            print(f"\n{COLOR_YELLOW}⚠ wl yüklendi ama kablosuz arabirim oluşmadı. Bilgisayarı yeniden başlatın; "
                  f"sorun sürerse 'sudo dmesg | grep -i wl' çıktısını MindOS ekibine iletin.{COLOR_RESET}")
            return
        err = (r.stderr or "").strip()
        if "rejected" in err.lower() or "Key" in err:
            print(f"\n{COLOR_YELLOW}⚠ Secure Boot modülün imzasını henüz tanımıyor. Bilgisayarı yeniden başlatın; mavi "
                  f"ekranda 'Enroll MOK' seçip kodu girin (kod yoksa: sudo mindpkg install broadcom).{COLOR_RESET}")
            return
        print(f"\n{COLOR_YELLOW}⚠ wl şimdi yüklenemedi ({err or 'bilinmeyen hata'}). Bilgisayarı yeniden başlatın.{COLOR_RESET}")
        return
    print(f"\n{COLOR_GREEN}✓ Broadcom Wi-Fi sürücüsü (wl) kuruldu.{COLOR_RESET} Etkinleşmesi için bilgisayarı yeniden başlatın.")
    if code:
        print(f"\n{COLOR_BOLD}Secure Boot açık:{COLOR_RESET} yeniden başlarken mavi bir ekran (MOK Manager) gelecek.\n"
              f"  'Enroll MOK' → 'Continue' → 'Yes' seçin ve şu kodu girin: {COLOR_BOLD}{code}{COLOR_RESET}\n"
              f"  Ardından 'Reboot'. Bu bir kez yapılır.")

_index_cache = None


def repo_index():
    """Tüm depo indeksleri, ad -> en yeni kayıt (bir kez okunur; 'update' sonrası yenilenir)"""
    global _index_cache
    if _index_cache is None:
        _index_cache = {}
        for r in sorted(Path(REPOS_CACHE).glob("*.json")):
            try:
                with open(r, "r", encoding="utf-8") as f:
                    packages = json.load(f).get("packages", [])
            except Exception:
                continue
            for pkg in packages:
                name = pkg.get("name")
                if not name or "snap" in str(pkg.get("version", "")):  # snap yönlendirme paketleri
                    continue
                pkg = dict(pkg, _repo=r.stem)
                old = _index_cache.get(name)
                if old is None or is_newer(full_version(pkg), full_version(old)):
                    _index_cache[name] = pkg
    return _index_cache


def find_in_index(pkg_name):
    """Yerel depo indekslerinde paketi arar"""
    return repo_index().get(pkg_name)


def dpkg_owned_conflicts(paths):
    """Sistem paket yöneticisine (dpkg) ait olup üzerine yazılacak dosyaları döndürür"""
    info = Path("/var/lib/dpkg/info")
    if not info.is_dir():
        return []
    owned = set()
    for lst in info.glob("*.list"):
        try:
            owned.update(lst.read_text(encoding="utf-8", errors="replace").splitlines())
        except Exception:
            pass
    merged = {"/bin": "/usr/bin", "/sbin": "/usr/sbin", "/lib": "/usr/lib", "/lib64": "/usr/lib64"}
    conflicts = []
    for p in paths:
        if p.endswith("/") or not os.path.lexists(p) or os.path.isdir(p):
            continue
        alts = {p}
        for short, full in merged.items():
            if p.startswith(full + "/"):
                alts.add(short + p[len(full):])
            elif p.startswith(short + "/"):
                alts.add(full + p[len(short):])
        if alts & owned:
            conflicts.append(p)
    return conflicts


def fetch_verified(pkg_name, target_meta):
    """Depo kaydındaki .mind dosyasını indirir, SHA256 ile doğrular ve önbellek yolunu döndürür"""
    url = target_meta.get("url") or ""
    filename = Path(target_meta.get("filename") or f"{pkg_name}.mind").name
    expected_sha256 = (target_meta.get("sha256") or "").lower()
    if not re.fullmatch(r"[0-9a-f]{64}", expected_sha256) or not filename.endswith(".mind"):
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' için depo kaydı eksik ya da geçersiz (SHA256 yok). Güvenlik için kurulmadı.")
        sys.exit(1)
    cached_file = Path(CACHE_DIR) / filename

    print(f"{COLOR_GREEN}==>{COLOR_RESET} İndiriliyor: {COLOR_BOLD}{pkg_name} {target_meta.get('version')}{COLOR_RESET} ...")
    print(f"  {COLOR_ACCENT}Kaynak:{COLOR_RESET} {url}")
    try:
        download_with_progress(url, cached_file)
    except Exception as e:
        cached_file.unlink(missing_ok=True)
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' MindOS deposundan indirilemedi: {e}")
        sys.exit(1)

    if expected_sha256:
        print(f"  {COLOR_ACCENT}Doğrulanıyor (SHA256)...{COLOR_RESET}")
        actual_sha256 = calculate_sha256(cached_file)
        if actual_sha256 != expected_sha256:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} SHA256 doğrulama başarısız! Dosya bozulmuş olabilir.")
            cached_file.unlink(missing_ok=True)
            sys.exit(1)
        print(f"  {COLOR_GREEN}✓ İmza doğrulandı.{COLOR_RESET}")

    return cached_file


def install_from_repo_or_name(pkg_name):
    """Depolarda paket adını arar, indirir, SHA256 doğrular ve kurar"""
    check_root()
    require_pkg_name(pkg_name)
    if pkg_name in ("nvidia", "nvidia-driver-mindos", "nvidia-driver") and is_mindos_paradise():
        install_nvidia()
        return
    if pkg_name in ("broadcom", "broadcom-wl", "broadcom-sta", "broadcom-sta-dkms", "wl") and is_mindos_paradise():
        install_broadcom()
        return
    if install_system_component(pkg_name):
        return
    # Flathub'a eşlenmiş adlar (discord, spotify, zoom ...) Debian'dan önce: bazı adlar Debian'da başka paket
    fp = flatpak_alias(pkg_name)
    if fp and not resolve_vendor_app(pkg_name)[0]:
        if flatpak_ready():
            install_flatpak(fp)
            return
    # Debian tabanlı sistemlerde (MindOS Paradise) önce üreticinin resmi deposu ve
    # sisteme özel derlenmiş Debian paketi denenir; yoksa MindOS .mind deposuna geçilir.
    if shutil.which("apt-get") and install_from_system(pkg_name):
        return

    target_meta = find_in_index(pkg_name)
    if not target_meta:
        print(f"{COLOR_BANNER}Paket yerel önbellekte bulunamadı, depolar güncelleniyor...{COLOR_RESET}")
        update_repos()
        target_meta = find_in_index(pkg_name)

    if not target_meta:
        # Son çare Flathub: adı tam eşleşen bir masaüstü uygulaması varsa onu kur
        if flatpak_ready(update_appstream=True):
            app_id = flathub_exact(pkg_name)
            if app_id:
                install_flatpak(app_id)
                return
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' MindOS deposunda, Debian'da ve Flathub'da bulunamadı.")
        print(f"{COLOR_ACCENT}İpucu:{COLOR_RESET} Benzer adları görmek için: {COLOR_BOLD}mindpkg search {pkg_name}{COLOR_RESET}")
        sys.exit(1)

    install_mind_file(fetch_verified(pkg_name, target_meta))


def delete_tracked_files(paths):
    """mindpkg'nin kurduğu dosyaları siler; dpkg'ye ait dosyalara ve sistem dizinlerine dokunmaz"""
    files = [f for f in paths if isinstance(f, str) and f.startswith("/")
             and ".." not in f.split("/") and f.rstrip("/") not in PROTECTED_PATHS]
    shared = set(dpkg_owned_conflicts(files))
    for file_path in sorted(files, key=len, reverse=True):
        if file_path in shared:
            continue  # bu dosya bir sistem paketine ait, silinmez
        p = Path(file_path)
        try:
            if p.is_symlink() or p.is_file():
                p.unlink(missing_ok=True)
            elif p.is_dir():
                if not any(p.iterdir()):
                    p.rmdir()
        except Exception:
            pass


def remove_package(pkg_name):
    """Sistemden kurulu bir paketi temiz bir şekilde kaldırır"""
    check_root()
    require_pkg_name(pkg_name)
    pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
    if not pkg_record.exists():
        sys_pkg = resolve_vendor_app(pkg_name)[0] or pkg_name
        st = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}", sys_pkg],
                            capture_output=True, text=True).stdout if shutil.which("dpkg-query") else ""
        fp = flatpak_installed_id(pkg_name)
        if fp and not st.startswith("ii"):
            print(f"{COLOR_RED}==>{COLOR_RESET} Flatpak uygulaması kaldırılıyor: {COLOR_BOLD}{fp}{COLOR_RESET} ...")
            res = subprocess.run(["flatpak", "uninstall", "-y", "--noninteractive", fp])
            if res.returncode == 0:
                print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {fp} kaldırıldı.")
            sys.exit(res.returncode)
        if st.startswith("ii") and shutil.which("apt-get"):
            print(f"{COLOR_RED}==>{COLOR_RESET} Sistem paketi kaldırılıyor: {COLOR_BOLD}{sys_pkg}{COLOR_RESET} ...")
            res = subprocess.run(["apt-get", "remove", "-y", "--", sys_pkg],
                                 env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
            if res.returncode == 0:
                run_system_triggers()
                print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {sys_pkg} sistemden kaldırıldı.")
            sys.exit(res.returncode)
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' sistemde kurulu değil!")
        sys.exit(1)

    with open(pkg_record, "r", encoding="utf-8") as f:
        meta = json.load(f)

    print(f"{COLOR_RED}==>{COLOR_RESET} Kaldırılıyor: {COLOR_BOLD}{pkg_name} ({meta.get('version')}){COLOR_RESET} ...")

    hook_dir = Path(HOOKS_DIR) / pkg_name
    if (hook_dir / "pre_remove.sh").exists():
        subprocess.run([str(hook_dir / "pre_remove.sh")])
    delete_tracked_files(meta.get("installed_files", []))
    if (hook_dir / "post_remove.sh").exists():
        subprocess.run([str(hook_dir / "post_remove.sh")])
    shutil.rmtree(hook_dir, ignore_errors=True)

    pkg_record.unlink(missing_ok=True)
    run_system_triggers()
    print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} sistemden kaldırıldı.")


