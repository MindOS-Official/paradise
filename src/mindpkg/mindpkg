def flatpak_alias(name):
    n = name.lower()
    for app_id, aliases in FLATPAK_APPS.items():
        if n == app_id.lower() or n in aliases:
            return app_id
    return None


def flatpak_ready(update_appstream=False):
    """flatpak kurulu ve Flathub ekli olsun (sistem geneli)"""
    if not shutil.which("flatpak"):
        if not shutil.which("apt-get"):
            return False
        print(f"{COLOR_GREEN}==>{COLOR_RESET} Flatpak kuruluyor...")
        apt_update_once()
        if subprocess.run(["apt-get", "install", "-y", "-q", "flatpak"],
                          env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"}).returncode != 0:
            return False
    subprocess.run(["flatpak", "remote-add", "--if-not-exists", "--system", "flathub", FLATHUB_URL],
                   capture_output=True)
    if update_appstream:
        subprocess.run(["flatpak", "update", "--appstream", "--system", "-y", "flathub"], capture_output=True)
    return True


def flatpak_search(query, limit=10):
    """Flathub'da arar: [(kimlik, ad, açıklama)]"""
    if not shutil.which("flatpak"):
        return []
    out = subprocess.run(["flatpak", "search", "--columns=application,name,description", query],
                         capture_output=True, text=True, env={**os.environ, "LC_ALL": "C.UTF-8"}).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and "." in parts[0]:
            rows.append((parts[0].strip(), parts[1].strip(), parts[2].strip() if len(parts) > 2 else ""))
    return rows[:limit]


def flathub_exact(name):
    """Adı tam eşleşen Flathub uygulaması (kimliğin son parçası ya da görünen ad)"""
    n = name.lower().replace(" ", "-")
    for app_id, title, _ in flatpak_search(name, limit=50):
        if app_id.lower() == n or app_id.rsplit(".", 1)[-1].lower() == n or title.lower().replace(" ", "-") == n:
            return app_id
    return None


def install_flatpak(app_id):
    print(f"{COLOR_GREEN}==>{COLOR_RESET} Flathub'dan kuruluyor: {COLOR_BOLD}{app_id}{COLOR_RESET} ...")
