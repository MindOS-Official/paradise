def _version_key(text):
    """dpkg yoksa kullanılan basit sürüm karşılaştırma anahtarı"""
    return [(0, int(t), "") if t.isdigit() else (1, 0, t) for t in re.findall(r"\d+|[A-Za-z]+", str(text))]


def is_newer(candidate, current):
    """candidate sürümü current'tan yeni mi? (Debian sürüm kuralları)"""
    if candidate == current:
        return False
    if shutil.which("dpkg"):
        return subprocess.run(["dpkg", "--compare-versions", str(candidate), "gt", str(current)]).returncode == 0
    return _version_key(candidate) > _version_key(current)


def full_version(meta):
    return f"{meta.get('version', '0')}-{meta.get('release', '1')}"


def latest_mindpkg_release():
    """Depo indekslerindeki en yeni mindpkg sürüm kaydını döndürür"""
    best = None
    for doc in meta_documents():
        entry = doc.get("mindpkg")
        if isinstance(entry, dict) and entry.get("version") and (best is None or is_newer(entry["version"], best["version"])):
            best = entry
    return best


# mindpkg sürümlerini imzalayan anahtar (özel anahtar yalnızca MindOS geliştiricisinde durur).
# GitHub deposu ele geçirilse bile imzasız ya da başka anahtarla imzalanmış mindpkg kurulmaz.
RELEASE_PUBKEY = """-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA0kq80lqdyWdIHD0A1w62Xsrp0QDcSQWEYOSxlz3lMhw=
-----END PUBLIC KEY-----
"""


def verify_release_signature(path, sig_b64):
    """Ed25519 imzasını openssl ile doğrular"""
    import base64
    if not shutil.which("openssl"):
        raise ValueError("openssl bulunamadı, imza doğrulanamıyor")
    try:
        sig = base64.b64decode(sig_b64, validate=True)
    except Exception:
        raise ValueError("imza biçimi bozuk")
    with tempfile.TemporaryDirectory() as td:
        pub = Path(td) / "pub.pem"
        sigf = Path(td) / "sig"
        pub.write_text(RELEASE_PUBKEY)
        sigf.write_bytes(sig)
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(pub), "-rawin",
                            "-in", str(path), "-sigfile", str(sigf)], capture_output=True, text=True)
        if r.returncode != 0:
            raise ValueError("imza geçersiz (resmi MindOS anahtarıyla imzalanmamış)")


def self_update():
    """Yeni mindpkg sürümü varsa indirir, doğrular, kendini değiştirir ve yeni sürümle devam eder"""
    print(f"{COLOR_GREEN}==>{COLOR_RESET} mindpkg güncellemesi denetleniyor...")
    rel = latest_mindpkg_release()
    if not rel or not is_newer(rel["version"], VERSION):
        print(f"  {COLOR_GREEN}✓{COLOR_RESET} mindpkg güncel (v{VERSION}).")
        return
    new_ver, url = str(rel["version"]), str(rel.get("url", ""))
    sha = str(rel.get("sha256", "")).lower()
    if not re.fullmatch(r"[0-9a-f]{64}", sha) or not re.fullmatch(r"[0-9A-Za-z.+~-]+", new_ver):
        print(f"  {COLOR_RED}⚠ mindpkg {new_ver} kaydı geçersiz (SHA256 yok), atlanıyor.{COLOR_RESET}")
        return
    self_path = Path(os.path.realpath(__file__))
    print(f"  {COLOR_ACCENT}Yeni sürüm:{COLOR_RESET} v{VERSION} → {COLOR_BOLD}v{new_ver}{COLOR_RESET}")
    fd, tmp = tempfile.mkstemp(prefix=".mindpkg-", dir=str(self_path.parent))
    os.close(fd)
    tmp = Path(tmp)
    try:
        download_with_progress(url, tmp)
        if calculate_sha256(tmp) != sha:
            raise ValueError("SHA256 doğrulaması başarısız")
        verify_release_signature(tmp, str(rel.get("sig", "")))
        code = tmp.read_text(encoding="utf-8")
        compile(code, str(tmp), "exec")  # sözdizimi bozuk bir dosya asla kurulmaz
        if f'VERSION = "{new_ver}"' not in code:
            raise ValueError("indirilen dosyanın sürümü beklenenle uyuşmuyor")
        shutil.copy2(self_path, Path(DB_DIR) / "mindpkg.previous")  # geri dönüş için
        os.chmod(tmp, 0o755)
        os.replace(tmp, self_path)
    except Exception as e:
        tmp.unlink(missing_ok=True)
        print(f"  {COLOR_RED}⚠ mindpkg güncellenemedi: {e}{COLOR_RESET}")
        return
    print(f"  {COLOR_GREEN}✓ mindpkg v{new_ver} kuruldu, yükseltme yeni sürümle sürüyor...{COLOR_RESET}\n")
    sys.stdout.flush()
    os.execv(sys.executable, [sys.executable, str(self_path), "upgrade", "--no-self-update", "--resumed",
                              *[a for a in sys.argv[2:] if a not in ("--no-self-update", "--resumed")]])


def system_components():
    """Depo indekslerindeki MindOS sistem bileşenleri (kernel, MindOS uygulamaları): ad -> en yeni kayıt"""
    found = {}
    for doc in meta_documents():
        entries = doc.get("system", [])
        for e in entries if isinstance(entries, list) else []:
            if not isinstance(e, dict):
                continue
            name, ver = str(e.get("name", "")), str(e.get("version", ""))
            if not valid_pkg_name(name) or not re.fullmatch(r"[0-9A-Za-z.+~:-]+", ver):
                continue
            if name not in found or is_newer(ver, found[name]["version"]):
                found[name] = e
    return found


def is_mindos_paradise():
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            if "MindOS Paradise" in f.read():
                return True
    except OSError:
        pass
    # os-release bir Debian güncellemesiyle değişse bile MindOS Paradise tanınsın
    return os.path.exists(RELEASE_FILE) and os.path.isdir("/usr/share/mindos")


def installed_version(name):
    """dpkg'de kurulu sürüm; kurulu değilse None"""
    cur = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}${Version}", name],
                         capture_output=True, text=True).stdout
    return cur[3:].strip() or None if cur.startswith("ii") else None


def pending_components(comps=None):
    """Depoda daha yenisi olan sistem bileşenleri: [(ad, kayıt, kurulu_sürüm|None)]"""
    if not (shutil.which("dpkg-query") and shutil.which("apt-get") and is_mindos_paradise()):
        return []
    pending = []
    for name, e in sorted((system_components() if comps is None else comps).items()):
        if kernel_flavor() == "debian" and re.match(r"linux-(image|headers)-.*-mindos$", name):
            continue  # NVIDIA 550 için Debian kernel'ine geçmiş bilgisayar
        cur = installed_version(name)
        if cur is None and e.get("optional"):
            # ör. kernel başlıkları: yalnızca istenince kurulur; ama eski kernel'in başlıkları kuruluysa
            # (NVIDIA/DKMS) yeni kernel'in başlıkları da gelir, yoksa sürücü yeni kernel'de derlenemez
            if not (name.startswith("linux-headers-") and subprocess.run(
                    ["dpkg-query", "-W", "-f=${db:Status-Abbrev}", "linux-headers-*-mindos"],
                    capture_output=True, text=True).stdout.count("ii")):
                continue
        if cur is None or is_newer(str(e["version"]), cur):
            pending.append((name, e, cur))
    return pending


def fetch_component(name, e, dest_dir):
    """Sistem bileşeni .deb'ini indirir; SHA256 ve MindOS imzasını doğrular. Hata olursa ValueError."""
    ver = str(e["version"])
    sha = str(e.get("sha256", "")).lower()
    if not re.fullmatch(r"[0-9a-f]{64}", sha):
        raise ValueError("kayıt geçersiz (SHA256 yok)")
    deb = Path(dest_dir) / f"{name}_{ver.replace(':', '%3a')}.deb"
    try:
        download_with_progress(str(e.get("url", "")), deb)
        if calculate_sha256(deb) != sha:
            raise ValueError("SHA256 doğrulaması başarısız")
        verify_release_signature(deb, str(e.get("sig", "")))
    except Exception:
        deb.unlink(missing_ok=True)
        raise
    return deb


APT_ENV = {"DEBIAN_FRONTEND": "noninteractive", "NEEDRESTART_MODE": "l"}
APT_OFFLINE_NET = ["-o", "Acquire::Retries=0", "-o", "Acquire::http::Timeout=5", "-o", "Acquire::https::Timeout=5"]
APT_OPTS = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold",
            "-o", "DPkg::Lock::Timeout=300"]


def install_system_component(name):
    """MindOS sistem bileşenini (ör. linux-headers-7.2.10-mindos) imzalı .deb'den kurar.
    'linux-headers' çalışan MindOS kernel'inin başlıklarıdır (NVIDIA, VirtualBox gibi DKMS modülleri için)."""
    if not (shutil.which("apt-get") and is_mindos_paradise()):
        return False
    if name in ("linux-headers", "kernel-headers", "linux-headers-mindos"):
        name = f"linux-headers-{os.uname().release}"
    comps = system_components()
    if name not in comps and name.startswith("linux-headers-"):
        update_repos()
        comps = system_components()
    e = comps.get(name)
    if not e:
        if name.startswith("linux-headers-") and name.endswith("-mindos"):
            print(f"{COLOR_RED}Hata:{COLOR_RESET} {name} depoda yok. Önce 'sudo mindpkg upgrade' ile kernel'i "
                  f"güncelleyip bilgisayarı yeniden başlatın.")
            sys.exit(1)
        return False
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS bileşeni kuruluyor: {COLOR_BOLD}{name} {e['version']}{COLOR_RESET}")
    try:
        deb = fetch_component(name, e, CACHE_DIR)
    except Exception as ex:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} {name} indirilemedi: {ex}")
        sys.exit(1)
    res = subprocess.run(["apt-get", "install", "-y", *APT_OPTS, str(deb.resolve())], env={**os.environ, **APT_ENV})
    deb.unlink(missing_ok=True)
    if res.returncode != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} {name} kurulamadı (apt-get çıkış kodu {res.returncode}).")
        sys.exit(1)
    print(f"{COLOR_GREEN}✓ {name} {e['version']} kuruldu.{COLOR_RESET}")
    return True


def cleanup_old_kernels():
    """Yeni MindOS kernel'i kurulunca eskileri kaldırır. En yeni iki kernel (yenisi sorun çıkarırsa
    GRUB'dan açılacak yedek) ve şu an çalışan kernel kalır; her biri ~100 MB, /boot dolmasın."""
    import functools
    out = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${Version} ${db:Status-Abbrev}\n",
                          "linux-image-*-mindos"], capture_output=True, text=True).stdout
    installed = [(f[0], f[1]) for f in (l.split() for l in out.splitlines()) if len(f) >= 3 and f[2] == "ii"]
    if len(installed) < 3:
        return
    installed.sort(key=functools.cmp_to_key(lambda a, b: 1 if is_newer(a[1], b[1]) else -1), reverse=True)
    keep = {installed[0][0], installed[1][0], f"linux-image-{os.uname().release}"}
    old = [pkg for pkg, _ in installed if pkg not in keep]
    if not old:
        return
    headers = subprocess.run(["dpkg-query", "-W", "-f=${Package} ${db:Status-Abbrev}\n", "linux-headers-*-mindos"],
                             capture_output=True, text=True).stdout.split("\n")
    have = {l.split()[0] for l in headers if len(l.split()) >= 2 and l.split()[1] == "ii"}
    old += [h for h in (p.replace("linux-image-", "linux-headers-", 1) for p in old) if h in have]
    print(f"  Eski kernel'ler kaldırılıyor: {', '.join(old)}")
    subprocess.run(["apt-get", "purge", "-y", *APT_OPTS, *old], env={**os.environ, **APT_ENV})



def upgrade_system_components():
    """Kernel ve MindOS uygulamalarını imzalı .deb paketleriyle günceller (yalnızca MindOS Paradise)"""
    pending = pending_components()
    if not pending:
        return
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS sistem bileşenleri güncelleniyor...")
    kernel_updated = False
    for name, e, cur in pending:
        ver = str(e["version"])
        print(f"  • {COLOR_BOLD}{name}{COLOR_RESET} {cur or '(yeni)'} → {ver}")
        try:
            deb = fetch_component(name, e, CACHE_DIR)
        except Exception as ex:
