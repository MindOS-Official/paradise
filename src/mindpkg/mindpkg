def flatpak_installed_id(name):
    """Kurulu Flatpak uygulamaları arasında adı/kimliği eşleşen"""
    if not shutil.which("flatpak"):
        return None
    out = subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True, text=True).stdout.split()
    cand = flatpak_alias(name) or name
    for app_id in out:
        if app_id.lower() == cand.lower() or app_id.rsplit(".", 1)[-1].lower() == name.lower():
            return app_id
    return None


def install_from_system(name):
    """mindpkg deposunda olmayan paketi üretici deposu veya Debian deposundan kurar"""
    if not shutil.which("apt-get"):
        return False
    if name in ("steam", "steam-launcher") and get_system_arch() == "aarch64":
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Steam resmi Linux istemcisi yalnızca x86_64 mimarisini destekler.")
        print("ARM64 sistemlerde x86_64 emülasyonu (FEX-Emu veya Box64) gereklidir.")
        sys.exit(1)
    pkg, spec = resolve_vendor_app(name)
    packages = [pkg]
    if spec:
        if spec.get("arm64_fallback") and get_debian_arch() == "arm64":
            fallback = spec["arm64_fallback"]
            print(f"{COLOR_YELLOW}Bilgi:{COLOR_RESET} {pkg} için resmi ARM64 Linux paketi bulunmuyor; {COLOR_BOLD}{fallback}{COLOR_RESET} kuruluyor.")
            pkg = fallback
            packages = [pkg]
            spec = None
        else:
            arch = spec.get("foreign_arch")
            if arch and arch not in subprocess.run(["dpkg", "--print-foreign-architectures"],
                                                    capture_output=True, text=True).stdout.split():
                print(f"{COLOR_GREEN}==>{COLOR_RESET} {arch} (32 bit) mimarisi etkinleştiriliyor...")
                subprocess.run(["dpkg", "--add-architecture", arch], check=True)
            packages = spec.get("packages", [pkg])
            url = spec["source"].split("\n")[0].split("]")[-1].split()[0]
            if not apt_repo_configured(spec.get("match", url)):
                print(f"{COLOR_GREEN}==>{COLOR_RESET} Resmi üretici deposu ekleniyor: {COLOR_BOLD}{url}{COLOR_RESET}")
                if not Path(spec["keyring"]).exists():
                    fetch_vendor_key(spec)
                Path(spec["list"]).write_text(spec["source"] + "\n", encoding="utf-8")
            global _apt_updated
            _apt_updated = False
    else:
        pkg = APT_ALIASES.get(name, name)
        packages = [pkg]
    apt_update_once()
    if not apt_has_candidate(pkg):
        return False
    print(f"{COLOR_GREEN}==>{COLOR_RESET} Sistem deposundan kuruluyor: {COLOR_BOLD}{pkg}{COLOR_RESET} ...")
    res = subprocess.run(["apt-get", "install", "-y", "-o", "Dpkg::Options::=--force-confdef",
                          "-o", "Dpkg::Options::=--force-confold", "--", *packages],
                         env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
    if res.returncode != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg}' kurulamadı (apt-get çıkış kodu {res.returncode}).")
        sys.exit(res.returncode)
    run_system_triggers()
    print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg} sisteme kuruldu.")
    return True


