def calculate_sha256(filepath):
    h = hashlib.sha256()
    with open(filepath, "rb") as f:
        while chunk := f.read(8192):
            h.update(chunk)
    return h.hexdigest()


def run_system_triggers():
    triggers = [
        ["ldconfig"],
        ["update-desktop-database", "-q", "/usr/share/applications"],
        ["gtk-update-icon-cache", "-q", "-t", "-f", "/usr/share/icons/hicolor"],
        ["glib-compile-schemas", "/usr/share/glib-2.0/schemas"]
    ]
    for cmd in triggers:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass


def download_with_progress(url, dest_path):
    """İlerleme çubuğu ile yerel veya uzak dosyayı kopyalar/indirir"""
    dest_path = Path(dest_path)
    dest_path.parent.mkdir(parents=True, exist_ok=True)

    if url.startswith("file://"):
        local_src = Path(url.replace("file://", ""))
        if local_src.exists():
            shutil.copyfile(local_src, dest_path)
            return
        else:
            raise FileNotFoundError(f"Yerel dosya bulunamadı: {local_src}")

    if not url.startswith("https://"):
        raise ValueError(f"güvensiz adres reddedildi (yalnızca https:// desteklenir): {url}")

    if shutil.which("curl"):
        show = ["--progress-bar"] if sys.stdout.isatty() and not dest_path.name.endswith(".part") else ["-sS"]
        res = subprocess.run(["curl", *show, "-L", "--fail", "--proto", "=https", "--proto-redir", "=https",
                              "--connect-timeout", "20", "--retry", "3", "--retry-delay", "2",
                              "-o", str(dest_path), url], check=False)
        if res.returncode == 0 and dest_path.exists() and dest_path.stat().st_size > 0:
            return

    req = urllib.request.Request(url, headers={"User-Agent": f"mindpkg/{VERSION} (MindOS)"})
    with urllib.request.urlopen(req, timeout=60) as response:
        if not response.geturl().startswith("https://"):
            raise ValueError(f"güvensiz yönlendirme reddedildi: {response.geturl()}")
        with open(dest_path, "wb") as f:
            shutil.copyfileobj(response, f)


class IndexSyncing(ValueError):
    """İndeks ile imzası aynı sürüme ait değil (depo az önce güncellendi, önbellekler eşitleniyor)"""


def verify_index(path, sig_path):
    """<dosya>.sig: {"sha256", "sig"}; imza MindOS sürüm anahtarıyla dosyanın baytları üzerinde"""
    try:
        with open(sig_path, encoding="utf-8") as f:
            meta = json.load(f)
    except Exception:
        raise ValueError("imza dosyası okunamadı")
    if calculate_sha256(path) != str(meta.get("sha256", "")).lower():
        raise IndexSyncing("depo şu an güncelleniyor, birkaç dakika sonra yeniden deneyin")
    verify_release_signature(path, str(meta.get("sig", "")))


def fetch_signed(url, dest, signed=True):
    """url'yi dest'e indirir; signed ise url.sig ile doğrular. Başarısızlıkta dest'e dokunulmaz."""
    tmp, tmp_sig = Path(f"{dest}.part"), Path(f"{dest}.sig.part")
    try:
        download_with_progress(url, tmp)
        with open(tmp, encoding="utf-8") as f:
            json.load(f)  # bozuk indeksi kabul etme
        if signed:
            try:
                download_with_progress(f"{url}.sig", tmp_sig)
            except Exception:
                raise ValueError("indeks imzasız (imza dosyası yok); güvenlik için kabul edilmedi")
            verify_index(tmp, tmp_sig)
        os.replace(tmp, dest)
    finally:
        tmp.unlink(missing_ok=True)
        tmp_sig.unlink(missing_ok=True)


def update_repos():
    """Uzak ve yerel MindOS depolarını günceller. İndeksler MindOS sürüm anahtarıyla imzalıdır;
    imzası doğrulanmayan indeks kabul edilmez, önceki (doğrulanmış) indeks kullanılmaya devam eder.
    İmzasız bir depo yalnızca mindpkg.conf'ta "signed": false ile bilerek eklenebilir."""
    check_root()
    cfg = load_config()
    repos = cfg.get("repositories", [])
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS depoları eşitleniyor...")
    for repo in repos:
        if not repo.get("enabled", True):
            continue
        name = repo["name"]
        index_url = f"{repo['url']}/packages.json"
        print(f"  {COLOR_ACCENT}• {name}:{COLOR_RESET} {index_url}")
        try:
            fetch_signed(index_url, Path(REPOS_CACHE) / f"{name}.json", repo.get("signed", True))
            print(f"    {COLOR_GREEN}✓ Başarıyla güncellendi" +
                  (" (imza doğrulandı)." if repo.get("signed", True) else " (imzasız depo).") + COLOR_RESET)
        except IndexSyncing as e:
            print(f"    {COLOR_BANNER}⚠ {e}{COLOR_RESET}")
        except Exception as e:
            print(f"    {COLOR_BANNER}⚠ Depo güncellenemedi: {e}{COLOR_RESET}")
    global _index_cache, _meta_cache
    _index_cache = None
    _meta_cache = None


