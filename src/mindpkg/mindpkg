def nvidia_gpus():
    """[(pci_device_id, açıklama)] — yalnızca ekran denetleyicisi sınıfındaki NVIDIA aygıtları"""
    out = subprocess.run(["lspci", "-nn", "-d", "10de:"], capture_output=True, text=True).stdout
    gpus = []
    for line in out.splitlines():
        if not re.search(r"\[030[02]\]", line):
            continue
        m = re.search(r"\[10de:([0-9a-f]{4})\]", line)
        if m:
            gpus.append((int(m.group(1), 16), line.split(": ", 1)[-1]))
    return gpus


def nvidia_generation(device_id):
    """PCI aygıt numarasından kuşak: 'modern' (Turing+), 'legacy' (Maxwell-Volta), 'old' (Kepler-)"""
    if device_id >= 0x1E00:
        return "modern"
    if device_id >= 0x1340:
        return "legacy"
    return "old"


def ensure_debian_nonfree():
    """NVIDIA sürücüsü Debian'ın contrib/non-free bileşenlerinde"""
    changed = False
    for path in [Path("/etc/apt/sources.list"), *Path("/etc/apt/sources.list.d").glob("*.list")]:
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        new = re.sub(r"^(deb\s+\S+debian\S*\s+\S+)\s+main(?:\s+non-free-firmware)?\s*$",
                     r"\1 main contrib non-free non-free-firmware", text, flags=re.M)
        if new != text:
            path.write_text(new, encoding="utf-8")
            changed = True
    return changed


def add_nvidia_repo():
    if Path(NVIDIA_REPO["keyring"]).exists() and Path(NVIDIA_REPO["list"]).exists():
        return
    print(f"{COLOR_GREEN}==>{COLOR_RESET} NVIDIA'nın resmi Debian deposu ekleniyor...")
    with tempfile.TemporaryDirectory() as td:
        pub = Path(td) / "nvidia.pub"
        download_with_progress(NVIDIA_REPO["key_url"], pub)
        shown = subprocess.run(["gpg", "--batch", "--with-colons", "--show-keys", str(pub)],
                               capture_output=True, text=True).stdout
        fprs = [l.split(":")[9] for l in shown.splitlines() if l.startswith("fpr:")]
        if NVIDIA_REPO["fingerprint"] not in fprs:
            raise ValueError("NVIDIA depo anahtarının parmak izi beklenenle uyuşmuyor; eklenmedi")
        subprocess.run(["gpg", "--batch", "--yes", "--dearmor", "-o", NVIDIA_REPO["keyring"], str(pub)], check=True)
    os.chmod(NVIDIA_REPO["keyring"], 0o644)
    Path(NVIDIA_REPO["list"]).write_text(NVIDIA_REPO["source"] + "\n", encoding="utf-8")


def secure_boot_enabled():
    r = subprocess.run(["mokutil", "--sb-state"], capture_output=True, text=True)
    return "SecureBoot enabled" in r.stdout


def queue_dkms_key_enrollment():
    """Secure Boot açıkken DKMS'in imzaladığı NVIDIA modülü, DKMS anahtarı onaylanana dek yüklenmez.
    Anahtar bir sonraki açılışta onaylanmak üzere sıraya alınır; kullanıcıya tek kullanımlık kod gösterilir."""
    pub = Path("/var/lib/dkms/mok.pub")
    if not (secure_boot_enabled() and pub.exists() and shutil.which("mokutil")):
        return None
    if "is already enrolled" in subprocess.run(["mokutil", "--test-key", str(pub)],
                                               capture_output=True, text=True).stdout:
        return None
    import secrets
    code = f"{secrets.randbelow(10 ** 6):06d}"
    with tempfile.TemporaryDirectory() as td:
        h = Path(td) / "hash"
        h.write_text(subprocess.run(["mokutil", f"--generate-hash={code}"], capture_output=True,
                                    text=True, check=True).stdout)
        subprocess.run(["mokutil", "--import", str(pub), "--hash-file", str(h)], check=True)
    return code


