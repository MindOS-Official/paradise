def ensure_directories():
    try:
        for d in [DB_DIR, INSTALLED_DIR, REPOS_CACHE, CACHE_DIR, HOOKS_DIR, "/etc/mindpkg", REPOS_DIR]:
            Path(d).mkdir(parents=True, exist_ok=True)
        if not os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(get_default_config(), f, indent=4)
    except PermissionError:
        if os.geteuid() == 0:
            raise  # yetkisiz kullanıcı (ör. Mind Arc'ın 'mindpkg check' çağrısı) yalnızca okur


def load_config():
    ensure_directories()
    sys_arch = get_system_arch()
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        return get_default_config()

    # Otomatik çoklu mimari yönlendirmesi: sistem aarch64 ise ve resmi depo x86 deposuna bakıyorsa arm64 reposuna yönlendir
    cfg_arch = cfg.get("architecture")
    if not cfg_arch:
        cfg["architecture"] = sys_arch
    for repo in cfg.get("repositories", []):
        if repo.get("name") == "official":
            url = repo.get("url", "")
            if sys_arch == "aarch64" and "MindOS-Official/packages/main" in url:
                repo["url"] = get_default_repo_url("aarch64")
            elif sys_arch == "x86_64" and "MindOS-Official/packages-arm64/main" in url:
                repo["url"] = get_default_repo_url("x86_64")
    return cfg


def check_root():
    if os.geteuid() != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Bu işlem için yönetici (root) yetkisi gereklidir.")
        print(f"Lütfen komutu {COLOR_BOLD}sudo mindpkg ...{COLOR_RESET} şeklinde çalıştırın.")
        sys.exit(1)


_lock_fd = None


def acquire_lock():
    """Aynı anda tek mindpkg işlemi (Mind Arc + terminal çakışmasın)"""
    global _lock_fd
    if _lock_fd is not None or os.geteuid() != 0:
        return
    Path(DB_DIR).mkdir(parents=True, exist_ok=True)
    _lock_fd = open(LOCK_FILE, "w")
    try:
        fcntl.flock(_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"{COLOR_YELLOW}Başka bir mindpkg işlemi sürüyor, bitmesi bekleniyor...{COLOR_RESET}")
        fcntl.flock(_lock_fd, fcntl.LOCK_EX)


PKG_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$")


def valid_pkg_name(name):
    """Paket adı dosya yolu ya da komut seçeneği olarak kötüye kullanılamasın"""
    return bool(PKG_NAME_RE.match(name or ""))


def require_pkg_name(name):
    if not valid_pkg_name(name):
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Geçersiz paket adı: {name!r}")
        sys.exit(1)


def safe_member_path(member):
    """Arşiv üyesini mutlak sistem yoluna çevirir; '..' içeren yolları reddeder"""
    clean = member.strip()
    while clean.startswith("./"):
        clean = clean[2:]
    clean = clean.lstrip("/")
    if not clean or clean == ".":
        return None
    if any(part == ".." for part in clean.split("/")):
        raise ValueError(f"güvensiz arşiv yolu: {member}")
    return "/" + clean.rstrip("/")


def validate_files_archive(archive):
    """files.tar.zst üyelerini denetler, kurulacak mutlak yolları döndürür.

    Reddedilenler: '..' içeren yollar; aygıt dosyaları; paket dışındaki bir dosyaya sabit bağlantı
    (ör. /etc/shadow); arşivdeki bir sembolik bağlantının *içine* yazılan üyeler (bağlantı /usr/bin'i
    gösterip ardından 'bağlantı/sudo' yazmak dpkg dosya denetimini atlatıp sistem dosyasının üzerine yazardı)."""
    import tarfile
    proc = subprocess.Popen(["zstd", "-dcq", str(archive)], stdout=subprocess.PIPE)
    paths, links, regular, hardlinks = [], set(), set(), []
    try:
        with tarfile.open(fileobj=proc.stdout, mode="r|") as tf:
            for m in tf:
                p = safe_member_path(m.name)
                if not p:
                    continue
                if m.ischr() or m.isblk():
                    raise ValueError(f"aygıt dosyası: {m.name}")
                if m.islnk():
                    target = safe_member_path(m.linkname)
                    hardlinks.append((m.name, target))
                if m.issym():
                    links.add(p)
                elif m.isfile():
                    regular.add(p)
                paths.append(p)
    except tarfile.TarError as e:
        raise ValueError(f"arşiv okunamadı: {e}")
    finally:
        proc.stdout.close()
        if proc.wait() != 0:
            raise ValueError("arşiv açılamadı (zstd)")
    for name, target in hardlinks:
        if target not in regular:
            raise ValueError(f"paket dışına sabit bağlantı: {name} -> {target}")
    for p in paths:
        parent = p.rsplit("/", 1)[0]
        while parent:
            if parent in links:
                raise ValueError(f"sembolik bağlantı üzerinden yazma: {p}")
            parent = parent.rsplit("/", 1)[0]
    return paths


