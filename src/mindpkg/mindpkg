def resolve_vendor_app(name):
    """Takma adı (chrome, vscode ...) gerçek paket adına çevirir"""
    for pkg, spec in VENDOR_APPS.items():
        if name == pkg or name in spec["aliases"]:
            return pkg, spec
    return None, None


def apt_repo_configured(url):
    """Bu adres zaten bir apt kaynağında tanımlı mı (aynı depo iki kez farklı anahtarla eklenirse apt hata verir)"""
    url = url.split("://", 1)[-1].rstrip("/")
    files = [Path("/etc/apt/sources.list"), *Path("/etc/apt/sources.list.d").glob("*")]
    for f in files:
        try:
            if url in f.read_text(encoding="utf-8", errors="replace"):
                return True
        except OSError:
            pass
    return False


def fetch_vendor_key(spec):
    """Üretici anahtarını indirir; parmak izi tablodakiyle tutmazsa reddeder. .gpg yolları ikili biçimde saklanır."""
    with tempfile.TemporaryDirectory() as td:
        raw = Path(td) / "key"
        download_with_progress(spec["key_url"], raw)
        shown = subprocess.run(["gpg", "--batch", "--with-colons", "--show-keys", str(raw)],
                               capture_output=True, text=True).stdout
        fprs = [l.split(":")[9] for l in shown.splitlines() if l.startswith("fpr:")]
        if spec.get("fingerprint") and spec["fingerprint"] not in fprs:
            raise SystemExit(f"{COLOR_RED}Hata:{COLOR_RESET} {spec['key_url']} anahtarının parmak izi beklenenle uyuşmuyor; depo eklenmedi.")
        data = raw.read_bytes()
        Path(spec["keyring"]).parent.mkdir(parents=True, exist_ok=True)
        if spec["keyring"].endswith(".gpg") and data.lstrip().startswith(b"-----BEGIN"):
            subprocess.run(["gpg", "--batch", "--yes", "--dearmor", "-o", spec["keyring"], str(raw)], check=True)
        else:
            Path(spec["keyring"]).write_bytes(data)
    os.chmod(spec["keyring"], 0o644)


def apt_update_once():
    global _apt_updated
    if not _apt_updated:
        print(f"  {COLOR_ACCENT}Sistem paket listeleri güncelleniyor...{COLOR_RESET}")
        subprocess.run(["apt-get", "update", "-qq"], check=False)
        _apt_updated = True


def apt_has_candidate(pkg):
    out = subprocess.run(["apt-cache", "policy", pkg], capture_output=True, text=True,
                         env={**os.environ, "LANG": "C"}).stdout
    for line in out.splitlines():
        if line.strip().startswith("Candidate:"):
            return line.split(":", 1)[1].strip() not in ("", "(none)")
    return False


