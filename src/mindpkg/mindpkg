_resolving = set()


def dep_alternatives(dep):
    """'libfoo (>= 1.2) | libbar:any' -> ['libfoo', 'libbar']"""
    out = []
    for alt in str(dep).split("|"):
        name = re.split(r"[\s(\[<>=]", alt.strip(), maxsplit=1)[0].split(":", 1)[0]
        if name:
            out.append(name)
    return out


def installed_names():
    """dpkg'de kurulu paket adları ve sağladıkları sanal paketler + mindpkg kayıtları"""
    names = {p.stem for p in Path(INSTALLED_DIR).glob("*.json")}
    if shutil.which("dpkg-query"):
        out = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}\t${Package}\t${Provides}\n"],
                             capture_output=True, text=True).stdout
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) == 3 and parts[0].startswith("ii"):
                names.add(parts[1])
                names.update(dep_alternatives(x)[0] for x in parts[2].split(",") if x.strip())
    return names


def resolve_dependencies(meta):
    """Paketin eksik bağımlılıklarını kurar (Debian tabanlı sistemde apt, yoksa .mind deposu)"""
    deps = [d for d in (meta.get("dependencies") or []) if dep_alternatives(d)]
    if not deps:
        return
    if not shutil.which("dpkg-query"):
        # dpkg'siz sistemlerde (LFS) kurulu kütüphaneler bilinemez; temel kütüphaneleri
        # (libc6 gibi) üstüne yazmak sistemi bozacağı için yalnızca bilgi verilir
        print(f"  {COLOR_ACCENT}Bağımlılıklar:{COLOR_RESET} {', '.join(dep_alternatives(d)[0] for d in deps)}")
        return
    have = installed_names()
    missing = [alts for alts in (dep_alternatives(d) for d in deps) if not any(a in have for a in alts)]
    if not missing:
        return
    print(f"{COLOR_GREEN}==>{COLOR_RESET} Eksik bağımlılıklar: {', '.join(m[0] for m in missing)}")
    via_apt, via_mind = [], []
    for alts in missing:
        if shutil.which("apt-get"):
            apt_update_once()
            pick = next((a for a in alts if apt_has_candidate(a)), None)
            if pick:
                via_apt.append(pick)
                continue
        pick = next((a for a in alts if find_in_index(a)), None)
        if pick:
            via_mind.append(pick)
        else:
            print(f"  {COLOR_YELLOW}⚠ Bulunamadı:{COLOR_RESET} {' | '.join(alts)}")
    if via_apt:
        res = subprocess.run(["apt-get", "install", "-y", "-o", "Dpkg::Options::=--force-confdef",
                              "-o", "Dpkg::Options::=--force-confold", "--", *via_apt],
                             env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
        if res.returncode != 0:
            print(f"  {COLOR_YELLOW}⚠ Bazı bağımlılıklar kurulamadı; paket eksik çalışabilir.{COLOR_RESET}")
    for name in via_mind:
        if name in _resolving:  # döngüsel bağımlılık
            continue
        _resolving.add(name)
        install_mind_file(fetch_verified(name, find_in_index(name)))


# ------------------------------------------------------------------------------
# Yerel .deb dosyası: .mind paketine dönüştürülüp kurulur (MindOS paket fabrikasıyla aynı yöntem).
# Debian bağımlılıkları olduğu gibi saklanır, eksikleri resolve_dependencies kurar; Debian kurulum
# betikleri .mind kancalarına sarılır, hata verirlerse kurulum durmaz.
# ------------------------------------------------------------------------------
DEB_MAINTSCRIPTS = {"preinst": ("pre_install.sh", "install"), "postinst": ("post_install.sh", "configure"),
                    "prerm": ("pre_remove.sh", "remove"), "postrm": ("post_remove.sh", "remove")}


def deb_hook_wrapper(pkg_name, script_name, arg, script_bytes):
    import base64
    b64 = base64.b64encode(script_bytes).decode()
    return f"""#!/bin/sh
# {pkg_name}: Debian {script_name} betiği (mindpkg .deb dönüştürmesi)
mkdir -p /var/lib/mindpkg/tmp; t=$(mktemp -p /var/lib/mindpkg/tmp) || exit 0
echo '{b64}' | base64 -d > "$t" && chmod 700 "$t"
DPKG_MAINTSCRIPT_PACKAGE={pkg_name} DPKG_MAINTSCRIPT_NAME={script_name} DPKG_ROOT= \\
DEBIAN_FRONTEND=noninteractive "$t" {arg} || echo "  ⚠ {pkg_name}: {script_name} betiği tamamlanamadı" >&2
rm -f "$t"
exit 0
"""


def convert_deb_to_mind(deb, outdir):
    """Bir .deb dosyasını .mind paketine dönüştürür, oluşan dosyanın yolunu döndürür"""
    if not shutil.which("dpkg-deb"):
        raise SystemExit(f"{COLOR_RED}Hata:{COLOR_RESET} .deb dönüştürmek için dpkg-deb gerekli.")
    field = lambda k: subprocess.run(["dpkg-deb", "-f", str(deb), k], capture_output=True, text=True).stdout.strip()
    name, version, arch = field("Package"), field("Version"), field("Architecture")
    if not name or not valid_pkg_name(name):
        raise SystemExit(f"{COLOR_RED}Hata:{COLOR_RESET} {deb} geçerli bir .deb paketi değil.")
    cur_deb_arch = get_debian_arch()
    cur_sys_arch = get_system_arch()
    if arch not in (cur_deb_arch, "all"):
        raise SystemExit(f"{COLOR_RED}Hata:{COLOR_RESET} {name} bu bilgisayar için değil (mimari: {arch}, gereken: {cur_deb_arch}).")
    desc = (field("Description").splitlines() or [name])[0]
    deps = [d.strip() for k in ("Pre-Depends", "Depends") for d in field(k).split(",") if d.strip()]
    meta = {"name": name, "version": version, "release": "1", "architecture": cur_sys_arch, "description": desc,
            "maintainer": field("Maintainer") or "?", "dependencies": deps, "origin": "local-deb", "format": 2}
    out = Path(outdir) / f"{name}-{version.replace(':', '_')}-1-{cur_sys_arch}.mind"
    with tempfile.TemporaryDirectory() as td:
        td = Path(td)
        root, pkg, ctrl = td / "root", td / "pkg", td / "control"
        root.mkdir(); pkg.mkdir()
        subprocess.run(["dpkg-deb", "-x", str(deb), str(root)], check=True)
        subprocess.run(["dpkg-deb", "-e", str(deb), str(ctrl)], check=True)
        hooks = []
        for script, (hook, arg) in DEB_MAINTSCRIPTS.items():
            if (ctrl / script).exists():
                (pkg / hook).write_text(deb_hook_wrapper(name, script, arg, (ctrl / script).read_bytes()), encoding="utf-8")
                (pkg / hook).chmod(0o755)
                hooks.append(script)
        meta["maintscripts"] = hooks
        (pkg / "metadata.json").write_text(json.dumps(meta, indent=4, ensure_ascii=False), encoding="utf-8")
        subprocess.run(["tar", "--zstd", "-cf", str(pkg / "files.tar.zst"), "--owner=0", "--group=0",
                        "--numeric-owner", "-C", str(root), "."], check=True)
        subprocess.run(["tar", "--zstd", "-cf", str(out), "--owner=0", "--group=0", "--numeric-owner",
                        "-C", str(pkg), "."], check=True)
    return out


def install_deb_file(file_path):
    """Yerel .deb dosyasını .mind'a dönüştürüp kurar; .mind kopyası önbellekte kalır"""
    check_root()
    deb = Path(file_path).resolve()
    if not deb.is_file():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Dosya bulunamadı: {deb}")
        sys.exit(1)
    print(f"{COLOR_GREEN}==>{COLOR_RESET} .deb paketi .mind biçimine dönüştürülüyor: {COLOR_BOLD}{deb.name}{COLOR_RESET}")
    Path(CACHE_DIR).mkdir(parents=True, exist_ok=True)
    mind = convert_deb_to_mind(deb, CACHE_DIR)
    print(f"  {COLOR_GREEN}✓{COLOR_RESET} {mind.name}")
    install_mind_file(mind)


def install_mind_file(file_path):
    """Yerel bir .mind dosyasını sisteme kurar"""
    check_root()
    file_path = Path(file_path).resolve()
    if not file_path.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Dosya bulunamadı: {file_path}")
        sys.exit(1)

    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(["tar", "--zstd", "-xf", str(file_path), "-C", tmpdir, "--no-same-owner"], check=True)
        except subprocess.CalledProcessError:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} {file_path} geçerli bir MindOS paketi değil!")
            sys.exit(1)

        meta_file = Path(tmpdir) / "metadata.json"
        if not meta_file.exists():
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Pakette metadata.json bulunamadı!")
            sys.exit(1)

        with open(meta_file, "r", encoding="utf-8") as f:
            meta = json.load(f)

        pkg_name = meta.get("name", "")
        pkg_ver = meta.get("version", "1.0")
        if not valid_pkg_name(pkg_name):
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket adı geçersiz: {pkg_name!r}")
            sys.exit(1)

        _resolving.add(pkg_name)
        resolve_dependencies(meta)
        print(f"{COLOR_GREEN}==>{COLOR_RESET} Kuruluyor: {COLOR_BOLD}{pkg_name} ({pkg_ver}){COLOR_RESET} ...")

        # Sistem (dpkg) dosyalarının üzerine yazma kontrolü - kancalardan önce
        files_archive = Path(tmpdir) / "files.tar.zst"
        if files_archive.exists():
            try:
                paths = validate_files_archive(files_archive)
            except ValueError as e:
                print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket reddedildi: {e}")
                sys.exit(1)
            conflicts = dpkg_owned_conflicts(paths)
            if conflicts and os.environ.get("MINDPKG_FORCE") != "1":
                print(f"{COLOR_RED}Hata:{COLOR_RESET} {pkg_name} sistem paketlerine ait {len(conflicts)} dosyanın üzerine yazacaktı:")
                for c in conflicts[:8]:
                    print(f"    {c}")
                print(f"  Sistemi korumak için kurulum durduruldu. Zorlamak için: {COLOR_BOLD}MINDPKG_FORCE=1 mindpkg install ...{COLOR_RESET}")
                sys.exit(1)

        # pre_install hook: başarısız olursa kurulum yapılmaz
        pre_install = Path(tmpdir) / "pre_install.sh"
        if pre_install.exists():
            os.chmod(pre_install, 0o755)
            if subprocess.run([str(pre_install)]).returncode != 0:
                print(f"{COLOR_RED}Hata:{COLOR_RESET} {pkg_name} kurulum öncesi betiği başarısız oldu, kurulum iptal edildi.")
                sys.exit(1)

        # Dosyaları çıkart ve listele
        files_archive = Path(tmpdir) / "files.tar.zst"
        installed_files = []
        if files_archive.exists():
            installed_files = list(paths)

            subprocess.run(["tar", "--zstd", "-xf", str(files_archive), "-C", "/",
                            "--no-same-owner", "--no-overwrite-dir"], check=True)

        # post_install hook
        post_install = Path(tmpdir) / "post_install.sh"
        if post_install.exists():
            os.chmod(post_install, 0o755)
            if subprocess.run([str(post_install)]).returncode != 0:
                print(f"  {COLOR_YELLOW}⚠ Kurulum sonrası betiği hata verdi.{COLOR_RESET}")

        # kaldırma kancaları saklanır; 'mindpkg remove' bunları çalıştırır
        hook_dir = Path(HOOKS_DIR) / pkg_name
        shutil.rmtree(hook_dir, ignore_errors=True)
        for hook in ("pre_remove.sh", "post_remove.sh"):
            if (Path(tmpdir) / hook).exists():
                hook_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(Path(tmpdir) / hook, hook_dir / hook)
                os.chmod(hook_dir / hook, 0o755)

        # Veritabanına kaydet
        meta["installed_files"] = installed_files
        pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
        with open(pkg_record, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=4)

        run_system_triggers()
        print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} ({pkg_ver}) sisteme kuruldu.")


