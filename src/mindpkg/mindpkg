def ensure_firmware_backports():
    """Backports kaynağını ve yalnızca firmware-* için önceliği ekler; değiştiyse True"""
    changed = False
    for path, text in FIRMWARE_BACKPORTS.items():
        p = Path(path)
        try:
            if p.read_text(encoding="utf-8") == text:
                continue
        except OSError:
            pass
        if not Path("/usr/share/keyrings/debian-archive-keyring.gpg").exists():
            return False
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        os.chmod(p, 0o644)
        changed = True
    return changed


def kernel_flavor():
    try:
